# 后端类型：worker | supabase
# 留空 = 纯本地模式（不发起任何网络请求，功能与原版完全一致）
VITE_BACKEND_KIND=

# 后端地址
#   worker   → Cloudflare Worker / Pages Function 根地址
#              ⚠️ 不要用 *.workers.dev：在中国大陆被 DNS 污染 + TLS 重置，国内用户访问不到。
#              国内可用的形态是 *.pages.dev（Pages Function + 同一个 D1 绑定）。
#   supabase → Supabase 项目地址，例如 https://xxxxxxx.supabase.co
VITE_BACKEND_URL=

# 仅 Supabase 需要：anon / publishable key（Worker 不需要）
VITE_BACKEND_ANON_KEY=
